{
  "type": "record",
  "name": "Order",
  "namespace": "com.ring.game",
  "doc": "A player order submitted to game.orders.raw",
  "fields": [
    {"name": "orderType", "type": "string", "doc": "ASSIGN_ROUTE|REDIRECT_UNIT|ATTACK_REGION|BLOCK_PATH|SEARCH_PATH|REINFORCE_REGION|FORTIFY_REGION|MAIA_ABILITY|DEPLOY_NAZGUL|DESTROY_RING"},
    {"name": "playerId",  "type": "string"},
    {"name": "unitId",    "type": "string"},
    {"name": "turn",      "type": "int"},
    {"name": "payload",   "type": {"type": "map", "values": "string"}, "default": {}}
  ]
}
