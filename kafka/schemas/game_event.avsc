{
  "type": "record",
  "name": "GameEvent",
  "namespace": "com.ring.game",
  "doc": "An event produced by the engine to game.events.* or game.broadcast",
  "fields": [
    {"name": "event",    "type": "string", "doc": "Event type name e.g. UnitMoved, BattleResolved, GameOver"},
    {"name": "turn",     "type": "int"},
    {"name": "unitId",   "type": ["null","string"], "default": null},
    {"name": "regionId", "type": ["null","string"], "default": null},
    {"name": "pathId",   "type": ["null","string"], "default": null},
    {"name": "data",     "type": {"type": "map", "values": "string"}, "default": {}}
  ]
}
